/*
 * Cosmos 5x6 - plain QWERTY. No home-row mods / hold-taps on the base layer
 * so it behaves like a normal keyboard for gaming. Remap live with ZMK Studio.
 *
 * Row 4 (bottom) per half = 2 outer finger keys + 4 thumb keys.
 * Right half is written in visual order (innermost thumb first).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define SYS   3

#define ___ &trans
#define XXX &none

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        sys_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5        &kp N6   &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T         &kp Y    &kp U      &kp I      &kp O     &kp P     &kp EQUAL
&kp ESC    &kp A     &kp S     &kp D      &kp F      &kp G         &kp H    &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B         &kp N    &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &mo LOWER  &kp SPACE  &kp BSPC      &kp RET  &mo RAISE  &kp DEL    &kp RALT  &kp LBKT  &kp RBKT
            >;
        };

        lower_layer {
            display-name = "Nav";
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4     &kp F5     &kp F6        &kp F7      &kp F8        &kp F9        &kp F10    &kp F11   &kp F12
___        ___       ___       ___        ___        ___           &kp PG_UP   &kp HOME      &kp UP        &kp END    &kp INS   &kp PSCRN
&kp CAPS   ___       ___       ___        ___        ___           &kp PG_DN   &kp LEFT      &kp DOWN      &kp RIGHT  ___       ___
___        ___       ___       ___        ___        ___           &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP   ___       ___
___        ___       ___       ___        ___        ___           ___         ___           ___           ___        ___       ___
            >;
        };

        raise_layer {
            display-name = "Sym/Num";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT    &kp HASH   &kp DLLR   &kp PRCNT     &kp CARET  &kp AMPS   &kp STAR   &kp LPAR      &kp RPAR         &kp UNDER
___        ___       ___       ___        ___        ___           &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp KP_DIVIDE    &kp BSLH
___        ___       ___       ___        ___        ___           &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp KP_MULTIPLY  &kp PIPE
___        ___       ___       ___        ___        ___           &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0     &kp KP_DOT       &kp KP_ENTER
___        ___       ___       ___        ___        ___           ___        ___        ___        ___           &kp LBRC         &kp RBRC
            >;
        };

        /* LOWER + RAISE together. &bootloader / &sys_reset act on the half
         * whose key you press, so you can flash either half without touching
         * its reset button. */
        sys_layer {
            display-name = "Sys";
            bindings = <
&bootloader     &sys_reset  XXX  XXX  XXX  XXX        XXX  XXX  XXX  XXX  &sys_reset  &bootloader
&studio_unlock  XXX         XXX  XXX  XXX  XXX        XXX  XXX  XXX  XXX  XXX         XXX
XXX             XXX         XXX  XXX  XXX  XXX        XXX  XXX  XXX  XXX  XXX         XXX
XXX             XXX         XXX  XXX  XXX  XXX        XXX  XXX  XXX  XXX  XXX         XXX
XXX             XXX         XXX  ___  XXX  XXX        XXX  ___  XXX  XXX  XXX         XXX
            >;
        };
    };
};
