#include "keys_lt.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define COLEMAK 0
#define NAV 1
#define NUM 2
#define SYM 3
#define FUN 4

/* krita base */

#define KRB 5

/* play */

#define PLAY 6

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
    quick_tap_ms = <75>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            timeout-ms = <100>;
            key-positions = <20 29>;
            bindings = <&caps_word>;
        };

        combo_esc {
            timeout-ms = <150>;
            key-positions = <10 19>;
            bindings = <&kp ESC>;
        };

        // (
        // )
        // {
        // }
        // [
        // ]
        // <
        // >

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <12 13>;
        };
    };

    behaviors {
        to_to: to_to {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_TO";
            bindings = <&to>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W               &kp F           &kp P               &kp G                           &kp J                   &kp L                &kp U            &kp Y                &kp SEMICOLON
&mt LEFT_SHIFT A  &mt LEFT_COMMAND R  &mt LEFT_ALT S  &mt LEFT_CONTROL T  &mt LG(LA(LC(LEFT_SHIFT))) D    &mt RS(RA(RC(RGUI))) H  &mt RIGHT_CONTROL N  &mt RIGHT_ALT E  &mt RIGHT_COMMAND I  &mt RIGHT_SHIFT O
&kp Z             &kp X               &kp C           &kp V               &kp B                           &kp K                   &kp M                &kp COMMA        &kp DOT              &kp FSLH
                                                      &to_to 3 0          &lt 2 SPACE                     &kp BACKSPACE           &to_to 5 1
            >;
        };

        sym_layer {
            bindings = <
&kp LS(Q)  &kp LS(Z)  &kp STAR   &kp AMPS  &trans         &sys_reset  &bootloader  &trans  &trans  &trans
&kp DQT    &kp CARET  &kp PRCNT  &kp DLLR  &kp KP_PLUS    &trans      &trans       &trans  &trans  &trans
&kp TILDE  &kp HASH   &kp AT     &kp EXCL  &kp PIPE       &trans      &trans       &trans  &trans  &trans
                                 &to 0     &kp RPAR       &trans      &trans
            >;
        };

        nav_layer {
            bindings = <
&trans  &trans  &trans  &bootloader  &sys_reset    &trans         &kp LBRC  &kp RBRC  &kp LPAR   &kp RPAR
&trans  &trans  &trans  &trans       &trans        &kp LEFT       &kp DOWN  &kp UP    &kp RIGHT  &trans
&trans  &trans  &trans  &trans       &trans        &trans         &kp LBKT  &kp RBKT  &trans     &trans
                        &to 0        &trans        &kp BACKSPACE  &to 3
            >;
        };

        num_layer {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F12    &trans    &kp N7  &kp N8  &kp N9  &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11    &kp BSPC  &kp N4  &kp N5  &kp N6  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F10    &trans    &kp N1  &kp N2  &kp N3  &trans
                        &to 0   &trans     &trans    &kp N0
            >;
        };

        fun_layer {
            bindings = <
&trans     &kp F7  &kp F8  &kp F9  &trans       &trans  &trans  &trans  &trans  &trans
&kp SQT    &kp F4  &kp F5  &kp F6  &kp EQUAL    &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp BSLH     &trans  &trans  &trans  &trans  &trans
                           &to 0   &trans       &trans  &trans
            >;
        };

        Lithuanian {
            bindings = <
&kp LT_A_OGON  &kp LT_C_CARON  &kp LT_E_OGON  &kp LT_E_DOT  &kp LT_I_OGON    &trans  &kp LT_S_CARON  &kp LT_U_OGON  &kp LT_U_MACRON  &kp LT_Z_CARON
&trans         &trans          &trans         &trans        &trans           &trans  &trans          &trans         &trans           &trans
&trans         &trans          &trans         &trans        &trans           &trans  &trans          &trans         &trans           &trans
                                              &to 0         &trans           &trans  &trans
            >;
        };
    };
};