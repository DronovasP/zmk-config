/*
 * Cosmos handwired split: 4 rows x 6 columns of finger keys + 3 thumb keys per
 * half (27 keys/half, 54 total). Thumbs are matrix row 4, columns 3-5; row 4
 * columns 0-2 have no switch.
 * Controller: nice!nano v2 in each half. Halves are mirror images and use the
 * SAME pins, so the pin lists below apply to both halves.
 *
 * Wired split over the TRRS cable (ZMK full-duplex wired split, v0.3+).
 * TRRS carries VCC, GND and the two UART lines:
 *   nice!nano  D1 / TX  (pro_micro 1, P0.06)  ->  other half's RX
 *   nice!nano  D0 / RX  (pro_micro 0, P0.08)  <-  other half's TX
 * so the cable/jacks must cross TX<->RX between the halves.
 * Do NOT wire any switch to pro_micro 0 or 1.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "cosmos-layouts.dtsi"

/* Enable the hardware UART on D0/D1 that the wired split uses. */
&pro_micro_serial {
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &cosmos_layout;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&pro_micro_serial>;
    };

    /* ================================================================
     * Matrix pins (as wired, 2026-08-29). pro_micro N = "D" pin number;
     * the P0.xx / P1.xx comments are the labels silk-screened on the
     * nice!nano (011 = P0.11, 100 = P1.00, ...).
     * Available for the matrix: 2 3 4 5 6 7 8 9 10 14 15 16 18 19 20 21
     * (0 and 1 are the TRRS UART lines).
     *
     * row-gpios: row 0 = top (number row) ... row 4 = thumb row (cols 3-5 only)
     * col-gpios: col 0 = outermost (pinky) ... col 5 = innermost (index)
     *
     * If a key prints the key of a neighbouring row/column, swap the pin
     * order here. If nothing prints at all, try diode-direction = "row2col".
     * ================================================================ */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.20 - row 0, top (numbers) */
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.22 - row 1 */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.24 - row 2 (home) */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P1.00 - row 3 */
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* P0.11 - row 4, thumb row */
            ;

        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* P0.31 - col 0, outer (pinky) */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* P0.29 - col 1 */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* P0.02 - col 2 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* P1.15 - col 3 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* P1.13 - col 4 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* P1.11 - col 5, inner (index / first thumb) */
            ;
    };

    /*
     * Logical matrix = 5 rows x 12 columns. Columns 0-5 are the left half,
     * 6-11 the right half (right overlay adds col-offset = 6). Row 4 only has
     * the three thumb keys per half (cols 3-5 / 9-11); the other row-4 matrix
     * positions are unpopulated and left out of the map.
     * Because the right half is mirrored, its outermost column is RC(r,6)
     * and its innermost is RC(r,11); the map is written in VISUAL order
     * (left-to-right as you look at the keyboard) so the keymap reads
     * naturally.
     */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7) RC(3,6)
                        RC(4,3) RC(4,4) RC(4,5)    RC(4,11) RC(4,10) RC(4,9)
        >;
    };
};

&cosmos_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};
